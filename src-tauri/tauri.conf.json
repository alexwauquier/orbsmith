{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Orbsmith",
  "version": "1.1.0",
  "identifier": "io.github.alexwauquier.orbsmith",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Orbsmith",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://cdn.discordapp.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Alex Wauquier",
    "homepage": "https://github.com/alexwauquier/orbsmith",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Alex Wauquier",
    "category": "Utility",
    "shortDescription": "Launch stand-in processes named after games",
    "longDescription": "Launches stand-in processes named after game executables, so that software detecting running games sees them as launched.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/orbsmith-dummy"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/usr/share/metainfo/io.github.alexwauquier.orbsmith.metainfo.xml": "linux/io.github.alexwauquier.orbsmith.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/io.github.alexwauquier.orbsmith.metainfo.xml": "linux/io.github.alexwauquier.orbsmith.metainfo.xml"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2NkJDMEZEMkYyMDEwRjkKUldUNUVDQXYvY0JydG5Cb256SFB6RFVMeUZDZ3Vqckw0eUF6YWJ6dnMrV2IyeXA0OEZ4Q2xjcTUK",
      "endpoints": [
        "https://github.com/alexwauquier/orbsmith/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
