<!-- AppStream metadata, read by software centers for the deb and rpm packages. -->
<component type="desktop-application">
  <id>io.github.alexwauquier.orbsmith</id>
  <!-- Tauri names the desktop entry after productName. -->
  <launchable type="desktop-id">Orbsmith.desktop</launchable>

  <name>Orbsmith</name>
  <summary>Launch stand-in processes named after games</summary>
  <developer id="io.github.alexwauquier">
    <name>Alex Wauquier</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      Orbsmith launches stand-in processes named after game executables, so that
      software detecting running games sees them as launched.
    </p>
    <ul>
      <li>Search the public list of detectable games, with their icons</li>
      <li>Run a game for a set time, or until you stop it</li>
      <li>Queue several games to run one after another or all at once</li>
      <li>Keep running from the system tray while the window is closed</li>
    </ul>
    <p>
      Orbsmith is not affiliated with any software or game publisher. Using it
      may go against the terms of service of the software that detects running
      games.
    </p>
  </description>

  <categories>
    <category>Utility</category>
  </categories>

